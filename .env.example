# Supabase config for the contact/feedback form.
# Copy to .env (or .env.local) and fill in from your Supabase project settings:
#   Project Settings -> API -> Project URL and anon/public key.
# The anon key is safe to expose in the browser; access is enforced by the
# Row Level Security policies in supabase/migrations/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
