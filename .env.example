# Supabase config for the contact/feedback form.
# Copy to .env (or .env.local) and fill in from your Supabase project settings:
#   Project Settings -> API -> Project URL and anon/public key.
# The anon key is safe to expose in the browser; access is enforced by the
# Row Level Security policies in supabase/migrations/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Safe Browsing v4 lookup for the /security-tools URL checker.
# Get a key from the Google Cloud console: enable the "Safe Browsing API",
# then APIs & Services -> Credentials -> Create credentials -> API key.
# NOTE: unlike the Supabase anon key, this one is NOT protected by anything on
# the other end. Restrict it in the Cloud console (HTTP referrer = your domain,
# API restriction = Safe Browsing API only), or proxy it through a Supabase
# Edge Function and drop it from the client entirely.
VITE_GOOGLE_SAFE_BROWSING_API_KEY=
